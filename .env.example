# Pooled connection, used by the running app (src/lib/prisma.ts).
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# Direct (non-pooled) connection, used by `prisma db push` / migrate (prisma.config.ts).
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"

ADMIN_USERNAME="youradminusername"
# Generate with: node scripts/hash-password.js yourpassword
# IMPORTANT: escape every "$" in the hash as "\$" or Next's env loader
# will try to interpolate it as a variable and corrupt the hash.
# (Not needed when pasting directly into Vercel's dashboard - only for local .env files.)
ADMIN_PASSWORD_HASH="\$2b\$12\$replace-with-generated-hash"
SESSION_SECRET="generate with: node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""
