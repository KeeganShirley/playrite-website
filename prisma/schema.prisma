generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Show {
  id          String   @id @default(cuid())
  date        DateTime
  time        String?
  venue       String
  city        String
  supportActs String?
  ticketUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Visitor {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
}

model GalleryPhoto {
  id        String   @id @default(cuid())
  url       String
  width     Int
  height    Int
  createdAt DateTime @default(now())
}
