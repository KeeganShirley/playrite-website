generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Show {
  id          String   @id @default(cuid())
  date        DateTime
  time        String?
  venue       String
  city        String
  supportActs String?
  ticketUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
